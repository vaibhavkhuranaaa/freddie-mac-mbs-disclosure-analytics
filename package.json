{
  "name": "freddie-mac-mbs-disclosure-analytics-demo",
  "version": "0.5.0",
  "type": "module",
  "private": true,
  "description": "Freddie Mac MBS issuance analytics case study.",
  "scripts": {
    "load:sample": "python3 -B scripts/pipeline.py --input tests/fixtures/issuance-sample --database \"${MBS_DATA_ROOT:-../freddie-mac-mbs-disclosure-analytics-data}/build/sample/mbs.sqlite\" --output \"${MBS_DATA_ROOT:-../freddie-mac-mbs-disclosure-analytics-data}/build/sample/dashboard.json\"",
    "load:raw": "python3 -B scripts/pipeline.py",
    "inventory:sources": "python3 -B scripts/source_inventory.py --contract contracts/m4-source-contract.json --contract contracts/m4-loan-source-contract.json --require-ready",
    "load:m4": "python3 -B scripts/storage.py preflight && python3 -B scripts/m4_conformance.py --database \"${MBS_DATA_ROOT:-../freddie-mac-mbs-disclosure-analytics-data}/build/manual/m4.sqlite\" --partition-dir \"${MBS_DATA_ROOT:-../freddie-mac-mbs-disclosure-analytics-data}/build/manual/loan\"",
    "verify:m4": "python3 -B scripts/m4_conformance.py --verify-existing",
    "verify:m4-safety": "python3 -B scripts/verify_m4_safety.py",
    "load:m5": "python3 -B scripts/storage.py preflight && python3 -B scripts/m5_metric_engine.py --output \"${MBS_DATA_ROOT:-../freddie-mac-mbs-disclosure-analytics-data}/build/manual/m5.sqlite\"",
    "repair:m5-4-join": "python3 -B scripts/m5_4_join_repair.py",
    "verify:m5": "python3 -B scripts/verify_m5_metrics.py",
    "storage:check": "python3 -B scripts/storage.py preflight",
    "storage:close": "python3 -B scripts/storage.py preflight --closure --enforce-budget",
    "test:python": "PYTHONDONTWRITEBYTECODE=1 python3 -B -m unittest discover -s tests -v",
    "test:analytics": "node tests/test_analytics.mjs",
    "test": "npm run test:python && npm run test:analytics",
    "validate:dashboard": "node scripts/validate_dashboard.mjs",
    "validate:product": "node scripts/validate_dashboard.mjs \"${MBS_DATA_ROOT:-../freddie-mac-mbs-disclosure-analytics-data}/product/dashboard.json\"",
    "smoke:static": "python3 -B scripts/smoke_static.py",
    "check": "npm run test && npm run verify:m4-safety && npm run validate:dashboard && npm run smoke:static",
    "build:product": "python3 -B scripts/build_product_payload.py",
    "check:product": "npm run build:product && npm run validate:product",
    "evaluate:m10": "python3 -B scripts/run_m10_evaluation.py --max-requests 2 --max-cost-usd 0.0080578",
    "verify:m10": "python3 -B scripts/run_m10_evaluation.py --verify-only",
    "verify:m11": "python3 -B -m unittest tests.test_investigation_backup tests.test_investigation_store tests.test_product_api tests.test_m11_evaluation tests.test_m11_infrastructure -v && az bicep build --file infra/m11/foundation.bicep --stdout >/dev/null && az bicep build --file infra/m11/app.bicep --stdout >/dev/null && python3 -B scripts/run_m11_evaluation.py --evidence \"${M11_EVIDENCE_PATH:?set M11_EVIDENCE_PATH}\"",
    "prepare:m12": "python3 -B scripts/prepare_m12_publication.py prepare --output /private/tmp/freddie-mac-mbs-publication",
    "verify:m12": "python3 -B -m unittest tests.test_m12_publication -v",
    "investigations:init": "python3 -B scripts/investigation_store.py init",
    "serve": "python3 -m http.server 4173 --directory app",
    "serve:product": "python3 -B scripts/serve_product.py"
  }
}
