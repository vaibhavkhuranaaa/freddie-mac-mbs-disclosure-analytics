{
  "name": "freddie-mac-mbs-disclosure-analytics-demo",
  "version": "0.4.0",
  "type": "module",
  "private": true,
  "description": "Freddie Mac MBS issuance analytics case study.",
  "scripts": {
    "load:sample": "python3 -B scripts/pipeline.py --input tests/fixtures/issuance-sample --database \"${MBS_DATA_ROOT:-../freddie-mac-mbs-disclosure-analytics-data}/build/sample/mbs.sqlite\" --output \"${MBS_DATA_ROOT:-../freddie-mac-mbs-disclosure-analytics-data}/build/sample/dashboard.json\"",
    "load:raw": "python3 -B scripts/pipeline.py",
    "inventory:sources": "python3 -B scripts/source_inventory.py --contract contracts/m4-source-contract.json --contract contracts/m4-loan-source-contract.json --require-ready",
    "load:m4": "python3 -B scripts/storage.py preflight && python3 -B scripts/m4_conformance.py --database \"${MBS_DATA_ROOT:-../freddie-mac-mbs-disclosure-analytics-data}/build/manual/m4.sqlite\" --partition-dir \"${MBS_DATA_ROOT:-../freddie-mac-mbs-disclosure-analytics-data}/build/manual/loan\"",
    "verify:m4": "python3 -B scripts/m4_conformance.py --incremental",
    "verify:m4-safety": "python3 -B scripts/verify_m4_safety.py",
    "load:m5": "python3 -B scripts/storage.py preflight && python3 -B scripts/m5_metric_engine.py --output \"${MBS_DATA_ROOT:-../freddie-mac-mbs-disclosure-analytics-data}/build/manual/m5.sqlite\"",
    "verify:m5": "python3 -B scripts/m5_metric_engine.py --incremental && python3 -B scripts/verify_m5_metrics.py",
    "storage:check": "python3 -B scripts/storage.py preflight --ops-root ../freddie-mac-mbs-disclosure-analytics-ops",
    "test:python": "python3 -B -m unittest discover -s tests -v",
    "test:analytics": "node tests/test_analytics.mjs",
    "test": "npm run test:python && npm run test:analytics",
    "validate:dashboard": "node scripts/validate_dashboard.mjs",
    "smoke:static": "python3 -B scripts/smoke_static.py",
    "check": "npm run test && npm run verify:m4-safety && npm run validate:dashboard && npm run smoke:static",
    "serve": "python3 -m http.server 4173 --directory app"
  }
}
