{
  "version": 1,
  "contract_id": "m4-monthly-loan-v1",
  "status": "approved",
  "approved_on": "2026-08-10",
  "authorization": "Owner-confirmed authorized row-level Freddie Mac use for the restricted local analyst workflow",
  "public_demo_rights": "Not approved; loan rows, identifiers, values, and derived loan-level products remain excluded from reviewer/public artifacts",
  "retention": "Retain restricted raw and loan-level derived data for seven years from acquisition; delete earlier if authorization ends",
  "native_grain": {
    "loan": "one disclosed loan/security relationship per reporting period and source delivery"
  },
  "timing": {
    "publication_date_source": "YYMMDD in the exact embedded member name",
    "publication_period": "calendar month containing publication_date",
    "report_period": "publication_period for the acquired monthly snapshots",
    "release_timing": "fourth business day at 4:30 P.M. per Disclosure Guide v6.2",
    "consolidation": "File 2 ends after 2026-03; File 1 contains the consolidated population beginning 2026-04; this is source-layout metadata, not economic activity"
  },
  "keys": {
    "business_key": ["Loan Identifier", "Security Identifier", "report_period"],
    "version_key": ["Loan Identifier", "Security Identifier", "report_period", "source_version_id"],
    "same_version_duplicate_policy": "quarantine every repeated business key and fail the source period",
    "cross_family_duplicate_policy": "classify as ambiguous, prevent publication to a latest view, and fail the source period"
  },
  "correction_precedence": {
    "immutable_rule": "append each accepted source delivery; never overwrite an earlier accepted version",
    "original_view": "earliest accepted source version for a business key as of the requested cutoff",
    "latest_view": "latest accepted source version for a business key as of the requested cutoff",
    "precedence": ["as_of_timestamp", "publication_date", "source_version_id"],
    "indicator": "Loan Correction Indicator N=no declared change, Y=changed, A=added, D=deleted",
    "same_precedence_tie": "quarantine as ambiguous and fail closed"
  },
  "release_modes": {
    "authorized": "restricted local FactLoanPeriod detail and value-free reconciliation metadata",
    "reviewer": "not approved; no row/detail value or derived loan-level product may be emitted",
    "public": "not approved"
  },
  "retention_policy": {
    "duration_years_from_acquisition": 7,
    "early_delete_condition": "authorization ends",
    "applies_to": ["raw", "staging", "conformed", "lineage"]
  },
  "dispositions": ["accepted", "excluded", "rejected", "duplicate", "quarantined", "published-to-conformed"],
