  "authorization": "Owner-confirmed authorized row-level Freddie Mac use for the restricted analyst workflow; no aggregate-only restriction applies inside that boundary",
  "public_demo_rights": "Not approved; restricted rows and derived security-level products remain excluded from public artifacts pending explicit license and publication approval",
  "retention": "Retain restricted raw and security-level derived data for seven years from acquisition; delete earlier if authorization ends",
  "native_grain": {
    "core": "one disclosed security per Security Factor Date and source delivery",
    "supplemental": "one provider record at its record-type-specific native grain; M4 validates and dispositions these records but does not flatten them into FactSecurityPeriod"
  },
  "timing": {
    "publication_date_source": "YYMMDD in the exact embedded member name",
    "publication_period": "calendar month containing publication_date",
    "report_period": "Security Factor Date for core rows; it must equal publication_period in the acquired monthly files",
    "release_timing": "fourth business day at 4:30 P.M. per Disclosure Guide v6.2",
    "consolidation": "File 2 families end after 2026-03; File 1 contains the consolidated population beginning 2026-04; this is source-layout metadata, not economic activity"
  },
  "keys": {
    "core_business_key": ["Security Identifier", "Security Factor Date"],
    "core_version_key": ["Security Identifier", "Security Factor Date", "source_version_id"],
    "supplemental_native_key": ["source_file", "source_row", "record_type"],
    "same_version_duplicate_policy": "quarantine every repeated business key and fail the source period",
    "cross_family_duplicate_policy": "classify as ambiguous, prevent publication to a latest view, and fail the source period"
  },
  "correction_precedence": {
    "immutable_rule": "append each accepted source delivery; never overwrite an earlier accepted version",
    "original_view": "earliest accepted source version for a business key as of the requested cutoff",
    "latest_view": "latest accepted source version for a business key as of the requested cutoff",
    "precedence": ["as_of_timestamp", "publication_date", "source_version_id"],
    "indicator": "Security Data Correction Indicator Y records provider-declared correction lineage; N records no declared correction",
    "same_precedence_tie": "quarantine as ambiguous and fail closed"
  },
  "release_modes": {
    "authorized": "restricted local FactSecurityPeriod detail and value-free reconciliation metadata",
    "reviewer": "not approved; no row/detail value or derived security-level product may be emitted",
    "public": "not approved"
  },
  "retention_policy": {
    "duration_years_from_acquisition": 7,
    "early_delete_condition": "authorization ends",
    "applies_to": ["raw", "staging", "conformed", "lineage"]
  },
  "dispositions": ["accepted", "excluded", "rejected", "duplicate", "quarantined", "published-to-conformed"],
