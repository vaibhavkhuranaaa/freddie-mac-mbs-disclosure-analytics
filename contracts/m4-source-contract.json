  "join_contract": {
    "grain": "one security observation per Security Factor Date and accepted source version",
    "effective_period": "Security Factor Date; embedded member date is publication date and must have the same calendar month",
    "business_keys": [
      "Security Identifier",
      "Security Factor Date"
    ],
    "correction_behavior": "original and latest views apply correction_precedence without overwriting immutable versions",
    "unmatched_policy": "retain every loan relationship with exactly one of matched, unmatched, ambiguous, late, ineligible, or terminated; block unexplained many-to-many joins"
  },
  "field_allowlist": [
    {"target": "prefix", "source_names": ["Prefix"], "type": "text", "nullable": false, "null_tokens": [], "sensitivity": "restricted", "authorized_use": "conformance and join evidence", "reviewer_rule": "excluded"},
    {"target": "security_id", "source_names": ["Security Identifier"], "type": "text", "nullable": false, "null_tokens": [], "sensitivity": "restricted", "authorized_use": "business key and authorized drill-through", "reviewer_rule": "excluded"},
    {"target": "security_factor_date", "source_names": ["Security Factor Date"], "type": "date", "nullable": false, "null_tokens": [], "sensitivity": "restricted", "authorized_use": "native reporting period", "reviewer_rule": "aggregate-only after separate approval"},
    {"target": "security_factor", "source_names": ["Security Factor"], "type": "decimal", "nullable": true, "null_tokens": [""], "sensitivity": "restricted", "authorized_use": "conformed source value only; no M4 paydown or prepayment formula", "reviewer_rule": "excluded"},
    {"target": "security_correction_indicator", "source_names": ["Security Data Correction Indicator"], "type": "enum", "nullable": false, "null_tokens": [], "sensitivity": "restricted", "authorized_use": "correction lineage", "reviewer_rule": "count-only after separate approval"},
    {"target": "security_status", "source_names": ["Security Status Indicator"], "type": "enum", "nullable": false, "null_tokens": [], "sensitivity": "restricted", "authorized_use": "eligibility and termination classification", "reviewer_rule": "count-only after separate approval"},
    {"target": "issuance_security_upb", "source_names": ["Issuance Investor Security UPB"], "type": "decimal", "nullable": true, "null_tokens": [""], "sensitivity": "restricted", "authorized_use": "conformed source value", "reviewer_rule": "aggregate-only after separate approval"},
    {"target": "current_security_upb", "source_names": ["Current Investor Security UPB"], "type": "decimal", "nullable": true, "null_tokens": [""], "sensitivity": "restricted", "authorized_use": "conformed source value", "reviewer_rule": "aggregate-only after separate approval"},
    {"target": "loan_count", "source_names": ["Loan Count"], "type": "integer", "nullable": true, "null_tokens": [""], "sensitivity": "restricted", "authorized_use": "conformed source value", "reviewer_rule": "aggregate-only after separate approval"},
    {"target": "legacy_credit_score", "source_names": ["WA Borrower Credit Score"], "type": "integer", "nullable": true, "null_tokens": [""], "sensitivity": "restricted", "authorized_use": "legacy score-system segment", "reviewer_rule": "excluded"},
    {"target": "classic_fico", "source_names": ["WA Classic FICO"], "type": "integer", "nullable": true, "null_tokens": [""], "sensitivity": "restricted", "authorized_use": "Classic FICO segment only", "reviewer_rule": "excluded"},
    {"target": "vs4", "source_names": ["WA VS4"], "type": "integer", "nullable": true, "null_tokens": [""], "sensitivity": "restricted", "authorized_use": "VS4 segment only", "reviewer_rule": "excluded"},
    {"target": "involuntary_removal_upb", "source_names": ["Involuntary Loan Removal (Prior Month UPB)"], "type": "decimal", "nullable": true, "null_tokens": [""], "sensitivity": "restricted", "authorized_use": "conformed source value; never labeled voluntary prepayment", "reviewer_rule": "aggregate-only after separate approval"},
    {"target": "involuntary_removal_count", "source_names": ["Involuntary Loan Removal (Loan Count)"], "type": "integer", "nullable": true, "null_tokens": [""], "sensitivity": "restricted", "authorized_use": "conformed source value", "reviewer_rule": "aggregate-only after separate approval"},
    {"target": "supplemental_record_type", "source_names": ["column_0"], "type": "text", "nullable": false, "null_tokens": [], "sensitivity": "restricted", "authorized_use": "native-layout validation and disposition only", "reviewer_rule": "count-only after separate approval"}
  ],
  "intended_measures": [
    {"name": "source_record_reconciliation", "scope": "M4 conformance counts only"},
    {"name": "security_version_and_correction_counts", "scope": "M4 lineage counts only"},
    {"name": "security_loan_join_reconciliation", "scope": "M4 reason counts only"}
  ]
}
